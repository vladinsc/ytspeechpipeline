# Docker network used by the Traefik instance that serves ai.asigno.ro.
TRAEFIK_NETWORK=traefik_traefik_net

# Physical GPU indices shown by nvidia-smi. The first runs WhisperX; the
# second runs Demucs and forced alignment.
YT_TRANSCRIBER_GPU_ID=6
YT_TRANSCRIBER_SECONDARY_GPU_ID=7
YT_TRANSCRIBER_BATCH_SIZE=16

# Bengee: two batch-4 workers per physical GPU (compose.bengee.yaml).
BENGEE_GPU_0=0
BENGEE_GPU_1=1
BENGEE_GPU_2=2
BENGEE_GPU_3=3
BENGEE_WORKER_COUNT=8
BENGEE_WHISPER_BATCH_SIZE=4
